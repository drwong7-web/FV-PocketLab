# Supabase — auth + user profile/plan storage.
# Both values are safe to expose in a browser bundle: the anon key only grants
# what row level security allows. Never put the service_role key in here.
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key

# Optional — Google Drive sync (see src/lib/sync/config.ts)
# VITE_SLFV_GDRIVE_CLIENT_ID=

# Creem (payments) — these are NOT Vite env vars. Set them as Supabase
# Edge Function secrets. See supabase/CREEM.md.
# CREEM_API_KEY=creem_test_...
# CREEM_WEBHOOK_SECRET=
# CREEM_PRODUCT_PRO_MONTHLY=prod_...
# CREEM_PRODUCT_PRO_YEARLY=prod_...
# CREEM_PRODUCT_LIFETIME=prod_...
# CREEM_TEST_MODE=true
